{
  "name": "wristplan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Rafał Ciesielski",
  "repository": "github:rciesielski3/wristplan",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "lefthook install",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "biome check . && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
